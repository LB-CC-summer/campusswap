@startuml
' 校易集 CampusSwap · E-R 图（16 张表全量，含基数）
' 作者：赖声雄  依据：db/schema.sql v2.0
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam dpi 200
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60
skinparam entity {
  BackgroundColor #EEF7F2
  BorderColor #2F7D5F
  FontSize 13
  AttributeFontSize 12
}
skinparam arrow {
  Color #4A6B5C
  FontSize 12
}
hide circle
skinparam classAttributeIconSize 0
hide empty members

title 图 5-2　校易集 CampusSwap E-R 图（16 表）

entity "campus\n校区" as campus {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(32) <<UK>>
  short_name : VARCHAR(20) <<UK>>
  city : VARCHAR(32)
  is_cross_city : TINYINT(1)
  is_enabled : TINYINT(1)
}

entity "user\n用户" as user {
  * id : BIGINT <<PK>>
  --
  email : VARCHAR(64) <<UK>>
  password_hash : VARCHAR(100)
  nickname : VARCHAR(32)
  role : ENUM
  status : ENUM
}

entity "user_profile\n用户资料" as user_profile {
  * user_id : BIGINT <<PK,FK>>
  --
  # campus_id : BIGINT <<FK>>
  verified_status : ENUM
  phone_enc : VARBINARY
}

entity "category\n分类" as category {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(32)
  # parent_id : BIGINT <<FK>>
  sort_no : INT
}

entity "product\n商品" as product {
  * id : BIGINT <<PK>>
  --
  # seller_id : BIGINT <<FK>>
  # category_id : BIGINT <<FK>>
  # campus_id : BIGINT <<FK>>
  title : VARCHAR(80)
  price : DECIMAL(10,2)
  status : ENUM
  support_mail : TINYINT(1)
  attributes : JSON
}

entity "product_image\n商品图片" as product_image {
  * id : BIGINT <<PK>>
  --
  # product_id : BIGINT <<FK>>
  url : VARCHAR(255)
  sort_no : INT
}

entity "favorite\n收藏" as favorite {
  * id : BIGINT <<PK>>
  --
  # user_id : BIGINT <<FK>>
  # product_id : BIGINT <<FK>>
}

entity "conversation\n会话" as conversation {
  * id : BIGINT <<PK>>
  --
  # product_id : BIGINT <<FK>>
  # buyer_id : BIGINT <<FK>>
  # seller_id : BIGINT <<FK>>
  last_message_at : DATETIME(3)
}

entity "message\n消息" as message {
  * id : BIGINT <<PK>>
  --
  # conversation_id : BIGINT <<FK>>
  # sender_id : BIGINT <<FK>>
  type : ENUM
  content : TEXT
}

entity "contact_exchange\n联系方式交换" as contact_exchange {
  * id : BIGINT <<PK>>
  --
  # conversation_id : BIGINT <<FK>>
  # requester_id : BIGINT <<FK>>
  # target_id : BIGINT <<FK>>
  status : ENUM
}

entity "block\n拉黑" as block {
  * id : BIGINT <<PK>>
  --
  # blocker_id : BIGINT <<FK>>
  # blocked_id : BIGINT <<FK>>
}

entity "trade\n交易单" as trade {
  * id : BIGINT <<PK>>
  --
  # product_id : BIGINT <<FK>>
  # buyer_id : BIGINT <<FK>>
  # seller_id : BIGINT <<FK>>
  status : ENUM
  confirmed_product_id : BIGINT <<UK 生成列>>
}

entity "report\n举报" as report {
  * id : BIGINT <<PK>>
  --
  # reporter_id : BIGINT <<FK>>
  target_type : ENUM
  # conversation_id : BIGINT <<FK>>
  allow_chat_access : TINYINT(1)
  status : ENUM
  result : ENUM
}

entity "chat_access_grant\n聊天片段授权" as chat_access_grant {
  * id : BIGINT <<PK>>
  --
  # report_id : BIGINT <<FK>>
  # admin_id : BIGINT <<FK>>
  # conversation_id : BIGINT <<FK>>
  window_start : DATETIME(3)
  expires_at : DATETIME(3)
  status : ENUM
  active_report_id : BIGINT <<UK 生成列>>
}

entity "admin_audit_log\n审计日志" as admin_audit_log {
  * id : BIGINT <<PK>>
  --
  # admin_id : BIGINT <<FK>>
  action : VARCHAR(40)
  target_type : VARCHAR(20)
  target_id : BIGINT
  detail : JSON
}

entity "agent_session\n智能体会话" as agent_session {
  * id : BIGINT <<PK>>
  --
  # user_id : BIGINT <<FK>>
  context : JSON
  status : ENUM
}

' ---------- 联系与基数 ----------
campus ||--o{ user_profile : 所在校区
campus ||--o{ product : 归属校区
user ||--|| user_profile : 1:1 资料
user ||--o{ product : 发布
category ||--o{ product : 所属分类
category ||--o| category : 父子
product ||--o{ product_image : 图片
user ||--o{ favorite : 收藏
product ||--o{ favorite : 被收藏
product ||--o{ conversation : 关联
user ||--o{ conversation : 买家或卖家
conversation ||--o{ message : 消息
conversation ||--o{ contact_exchange : 交换申请
user ||--o{ block : 拉黑
product ||--o{ trade : 交易单
user ||--o{ trade : 买家或卖家
user ||--o{ report : 提交或处理
report ||--o{ chat_access_grant : 按次授权
conversation ||--o{ chat_access_grant : 限定范围
user ||--o{ admin_audit_log : 操作留痕
user ||--o{ agent_session : 使用助手

legend bottom
  * 主键（PK）　　# 外键（FK）　　UK 唯一索引
  ‖—o{  1 比 0..N 　　‖—‖  1 比 1
  16 张表 = 14 个概念实体 + 2 张支撑表（chat_access_grant、admin_audit_log）；完整字段见说明书第 4 章。
end legend

@enduml

